{%- comment -%}
  Lookbook Gallery
  A grid of looks. Clicking a look opens a popup with the photo and every
  product in that look. Each look gets a deep link (e.g. /pages/lookbook#look-2)
  so emails and ads can open a specific look.

  Theme-agnostic: one file, no theme classes or CSS variables required.
  Fonts, text color, heading styles and money format come from your theme.
  Popup colors are detected from the page unless you set them.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  case s.image_ratio
    when 'portrait-tall'
      assign ratio = '2 / 3'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '3 / 2'
    else
      assign ratio = 'auto'
  endcase

  case s.product_image_ratio
    when 'square'
      assign thumb_ratio = '1 / 1'
    when 'portrait-tall'
      assign thumb_ratio = '2 / 3'
    else
      assign thumb_ratio = '4 / 5'
  endcase

  case s.product_image_size
    when 'small'
      assign thumb_width = 72
    when 'large'
      assign thumb_width = 140
    else
      assign thumb_width = 104
  endcase

  if s.content_width == 'full'
    assign max_width = 'none'
  else
    assign max_width = s.max_width | append: 'px'
  endif

  assign anchor_prefix = s.anchor_prefix | handleize | default: 'look'
  assign heading_tag = s.heading_size | default: 'h2'
  assign overlay = s.overlay_opacity | divided_by: 100.0
-%}

<lookbook-gallery
  id="LookbookGallery-{{ section.id }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-label-add="{{ s.add_to_cart_label | escape }}"
  data-label-adding="{{ s.adding_label | escape }}"
  data-label-added="{{ s.added_label | escape }}"
  data-label-select="{{ s.select_option_label | escape }}"
  data-label-sold-out="{{ s.sold_out_label | escape }}"
  class="lbg lbg--hover-{{ s.hover_effect }}{% if ratio == 'auto' %} lbg--natural{% endif %} lbg--titles-{{ s.card_titles }} lbg--popup-image-{{ s.popup_image_position }} lbg--cta-{{ s.cta_style }}"
  style="
    --lbg-cols-d: {{ s.columns_desktop }};
    --lbg-cols-t: {{ s.columns_desktop | at_most: 3 }};
    --lbg-cols-m: {{ s.columns_mobile }};
    --lbg-gap: {{ s.gap }}px;
    --lbg-ratio: {{ ratio }};
    --lbg-radius: {{ s.corner_radius }}px;
    --lbg-max-width: {{ max_width }};
    --lbg-pad: {{ s.side_padding }}px;
    --lbg-pt: {{ s.padding_top }}px;
    --lbg-pb: {{ s.padding_bottom }}px;
    --lbg-popup-w: {{ s.popup_width }}px;
    --lbg-popup-h: {{ s.popup_height }}px;
    --lbg-thumb-w: {{ thumb_width }}px;
    --lbg-thumb-ratio: {{ thumb_ratio }};
    --lbg-overlay: {{ overlay }};
    {%- if s.popup_background != blank %}--lbg-popup-bg: {{ s.popup_background }};{% endif -%}
    {%- if s.popup_text != blank %}--lbg-popup-fg: {{ s.popup_text }};{% endif -%}
  "
>
  <div class="lbg__container">
    {%- if s.heading != blank -%}
      <{{ heading_tag }} class="lbg__heading {{ heading_tag }}" style="text-align: {{ s.heading_alignment }};">
        {{- s.heading -}}
      </{{ heading_tag }}>
    {%- endif -%}
    {%- if s.intro != blank -%}
      <div class="lbg__intro" style="text-align: {{ s.heading_alignment }};">{{ s.intro }}</div>
    {%- endif -%}

    <ul class="lbg__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign look_image = block.settings.image
          if look_image == blank and block.settings.products.size > 0
            assign look_image = block.settings.products.first.featured_image
          endif
          assign look_label = block.settings.title
          if look_label == blank
            assign look_label = 'Look ' | append: forloop.index
          endif
        -%}
        <li class="lbg__item" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="lbg__opener"
            data-lbg-open="{{ forloop.index0 }}"
            aria-haspopup="dialog"
            aria-label="{{ look_label | escape }}"
          >
            <span class="lbg__media">
              {%- if look_image != blank -%}
                {{
                  look_image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900, 1100, 1400',
                    sizes: '(min-width: 990px) 33vw, 50vw',
                    alt: look_label
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'lbg__placeholder' }}
              {%- endif -%}
              {%- if s.card_titles == 'overlay' and block.settings.title != blank -%}
                <span class="lbg__card-title">{{ block.settings.title }}</span>
              {%- endif -%}
              {%- if s.card_hint != blank -%}
                <span class="lbg__card-hint">{{ s.card_hint }}</span>
              {%- endif -%}
            </span>
            {%- if s.card_titles == 'below' and block.settings.title != blank -%}
              <span class="lbg__card-title">{{ block.settings.title }}</span>
            {%- endif -%}
          </button>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <dialog class="lbg__dialog" aria-label="{{ s.heading | default: 'Lookbook' | escape }}">
    <div class="lbg__dialog-inner">
      <button type="button" class="lbg__close" data-lbg-close aria-label="Close">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
      </button>

      {%- for block in section.blocks -%}
        {%- liquid
          assign look_image = block.settings.image
          if look_image == blank and block.settings.products.size > 0
            assign look_image = block.settings.products.first.featured_image
          endif
          assign anchor = block.settings.anchor | handleize
          if anchor == blank
            assign anchor = anchor_prefix | append: '-' | append: forloop.index
          endif
        -%}
        <article
          class="lbg__panel"
          data-lbg-panel="{{ forloop.index0 }}"
          data-anchor="#{{ anchor }}"
          data-block-id="{{ block.id }}"
          hidden
        >
          <div class="lbg__panel-media">
            {%- if look_image != blank -%}
              {{
                look_image
                | image_url: width: 1600
                | image_tag: loading: 'lazy', widths: '540, 720, 1024, 1400, 1600', sizes: '(min-width: 750px) 50vw, 100vw'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'lbg__placeholder' }}
            {%- endif -%}

            {%- if s.show_arrows and section.blocks.size > 1 -%}
              <button type="button" class="lbg__arrow lbg__arrow--prev" data-lbg-prev aria-label="Previous look">
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M12.5 4l-6 6 6 6" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
              </button>
              <button type="button" class="lbg__arrow lbg__arrow--next" data-lbg-next aria-label="Next look">
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M7.5 4l6 6-6 6" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
              </button>
            {%- endif -%}
          </div>

          <div class="lbg__panel-body">
            {%- if block.settings.subtitle != blank -%}
              <p class="lbg__look-subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h2 class="lbg__look-title h3">{{ block.settings.title }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="lbg__look-text rte">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- if block.settings.products.size > 0 -%}
              <ul class="lbg__products" role="list">
                {%- for product in block.settings.products -%}
                  {%- capture product_image -%}
                    {%- if product.featured_image -%}
                      {{
                        product.featured_image
                        | image_url: width: 400
                        | image_tag: loading: 'lazy', widths: '150, 280, 400', sizes: '140px', alt: product.featured_image.alt
                      }}
                    {%- endif -%}
                  {%- endcapture -%}
                  {%- if s.product_action == 'quick_add' -%}
                    <li class="lbg__product lbg__product--quick-add" data-lbg-product>
                      <a href="{{ product.url }}" class="lbg__product-image" tabindex="-1" aria-hidden="true">
                        {{- product_image -}}
                      </a>
                      <div class="lbg__product-info">
                        {%- if s.show_vendor -%}
                          <span class="lbg__product-vendor">{{ product.vendor }}</span>
                        {%- endif -%}
                        <a href="{{ product.url }}" class="lbg__product-title">{{ product.title }}</a>
                        {%- if s.show_price -%}
                          <span class="lbg__product-price">
                            {%- if product.price_varies %}{{ s.price_from_label }} {% endif -%}
                            {%- if product.compare_at_price > product.price -%}
                              <s>{{ product.compare_at_price | money }}</s>
                            {%- endif -%}
                            <span>{{ product.price | money }}</span>
                          </span>
                        {%- endif -%}

                        {%- if product.available -%}
                          <div class="lbg__quick-add">
                            {%- unless product.has_only_default_variant -%}
                              {%- for option in product.options_with_values -%}
                                <fieldset
                                  class="lbg__option{% if option.values.size == 1 %} lbg__option--single{% endif %}"
                                  data-lbg-option="{{ forloop.index0 }}"
                                  data-name="{{ option.name | escape }}"
                                >
                                  <legend class="lbg__option-name">{{ option.name }}</legend>
                                  <div class="lbg__option-values">
                                    {%- for value in option.values -%}
                                      <button
                                        type="button"
                                        class="lbg__chip"
                                        data-lbg-chip
                                        data-value="{{ value | escape }}"
                                        aria-pressed="{% if option.values.size == 1 %}true{% else %}false{% endif %}"
                                      >
                                        {{- value -}}
                                      </button>
                                    {%- endfor -%}
                                  </div>
                                </fieldset>
                              {%- endfor -%}
                            {%- endunless -%}

                            <button
                              type="button"
                              class="lbg__add"
                              data-lbg-add
                              {% if product.has_only_default_variant %}
                                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                              {% endif %}
                            >
                              {{- s.add_to_cart_label -}}
                            </button>
                            <p class="lbg__add-status" data-lbg-status role="status" aria-live="polite"></p>

                            <script type="application/json" data-lbg-variants>
                              [
                                {%- for v in product.variants -%}
                                  {
                                    "id": {{ v.id }},
                                    "available": {{ v.available | json }},
                                    "options": {{ v.options | json }}
                                    {%- if v.featured_image -%}
                                      , "image": {{ v.featured_image | image_url: width: 400 | json }}
                                    {%- endif -%}
                                  }
                                  {%- unless forloop.last %},{% endunless -%}
                                {%- endfor -%}
                              ]
                            </script>
                          </div>
                        {%- else -%}
                          <span class="lbg__product-soldout">{{ s.sold_out_label }}</span>
                        {%- endif -%}
                      </div>
                    </li>
                  {%- else -%}
                    <li class="lbg__product">
                      <a href="{{ product.url }}" class="lbg__product-link">
                        <span class="lbg__product-image">{{ product_image }}</span>
                        <span class="lbg__product-info">
                          {%- if s.show_vendor -%}
                            <span class="lbg__product-vendor">{{ product.vendor }}</span>
                          {%- endif -%}
                          <span class="lbg__product-title">{{ product.title }}</span>
                          {%- if s.show_price -%}
                            <span class="lbg__product-price">
                              {%- if product.price_varies %}{{ s.price_from_label }} {% endif -%}
                              {%- if product.compare_at_price > product.price -%}
                                <s>{{ product.compare_at_price | money }}</s>
                              {%- endif -%}
                              <span>{{ product.price | money }}</span>
                            </span>
                          {%- endif -%}
                          {%- unless product.available -%}
                            <span class="lbg__product-soldout">{{ s.sold_out_label }}</span>
                          {%- endunless -%}
                          {%- if s.cta_style != 'none' and s.product_link_label != blank -%}
                            <span class="lbg__product-cta">{{ s.product_link_label }}</span>
                          {%- endif -%}
                        </span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- elsif request.design_mode -%}
              <p class="lbg__empty">Add products to this look in the theme editor.</p>
            {%- endif -%}

            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a href="{{ block.settings.button_link }}" class="lbg__look-button button">{{ block.settings.button_label }}</a>
            {%- endif -%}

            {%- if s.product_action == 'quick_add' -%}
              <div class="lbg__bag" data-lbg-bag hidden>
                <span class="lbg__bag-count" data-lbg-bag-count data-template="{{ s.bag_count_label | escape }}"></span>
                <a href="{{ routes.cart_url }}" class="lbg__bag-link">{{ s.view_cart_label }}</a>
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </dialog>
</lookbook-gallery>

{% stylesheet %}
  lookbook-gallery {
    display: block;
    padding-top: calc(var(--lbg-pt) * 0.75);
    padding-bottom: calc(var(--lbg-pb) * 0.75);
  }

  .lbg__container {
    max-width: var(--lbg-max-width);
    margin-inline: auto;
    padding-inline: min(var(--lbg-pad), 16px);
    box-sizing: content-box;
  }

  .lbg__heading {
    margin: 0 0 0.6em;
  }

  .lbg__intro {
    margin: 0 0 2em;
  }

  /* Grid */
  .lbg__grid {
    display: grid;
    grid-template-columns: repeat(var(--lbg-cols-m), minmax(0, 1fr));
    gap: var(--lbg-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lbg--natural .lbg__grid {
    align-items: start;
  }

  .lbg__item {
    margin: 0;
    padding: 0;
  }

  .lbg__opener {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    cursor: pointer;
  }

  .lbg__opener:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .lbg__media {
    position: relative;
    display: block;
    aspect-ratio: var(--lbg-ratio);
    overflow: hidden;
    border-radius: var(--lbg-radius);
    background: rgba(127, 127, 127, 0.08);
  }

  .lbg__media img,
  .lbg__media .lbg__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, opacity 0.3s ease;
  }

  .lbg--natural .lbg__media img {
    position: static;
    height: auto;
  }

  .lbg--hover-zoom .lbg__opener:hover img {
    transform: scale(1.04);
  }

  .lbg--hover-fade .lbg__opener:hover img {
    opacity: 0.85;
  }

  .lbg__card-title {
    display: block;
    margin-top: 0.6em;
  }

  .lbg--titles-overlay .lbg__card-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 2.5em 1em 1em;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent);
    color: #fff;
  }

  .lbg__card-hint {
    position: absolute;
    top: 50%;
    left: 50%;
    padding: 0.6em 1.1em;
    transform: translate(-50%, -50%);
    background: rgba(255, 255, 255, 0.92);
    color: #111;
    font-size: 0.8em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .lbg__opener:hover .lbg__card-hint,
  .lbg__opener:focus-visible .lbg__card-hint {
    opacity: 1;
  }

  .lbg__placeholder {
    fill: rgba(127, 127, 127, 0.4);
  }

  /* Popup: bottom sheet on mobile */
  .lbg__dialog {
    --lbg-bg: var(--lbg-popup-bg, var(--lbg-auto-bg, #fff));
    --lbg-fg: var(--lbg-popup-fg, var(--lbg-auto-fg, #121212));
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: 100%;
    max-height: 92dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: min(var(--lbg-radius), 16px) min(var(--lbg-radius), 16px) 0 0;
    background: var(--lbg-bg);
    color: var(--lbg-fg);
    overflow: hidden;
  }

  .lbg__dialog::backdrop {
    background: rgba(0, 0, 0, var(--lbg-overlay, 0.5));
  }

  .lbg__dialog[open] {
    animation: lbg-sheet-up 0.25s ease-out;
  }

  @keyframes lbg-sheet-up {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  .lbg__dialog-inner {
    position: relative;
    max-height: 92dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .lbg__close {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    height: 52px;
    margin: 0;
    padding: 0 16px;
    border: 0;
    background: var(--lbg-bg);
    color: inherit;
    cursor: pointer;
  }

  .lbg__close svg,
  .lbg__arrow svg {
    width: 20px;
    height: 20px;
  }

  .lbg__panel-media {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 70dvh;
    width: 100%;
    background: rgba(127, 127, 127, 0.08);
  }

  .lbg__panel-media img,
  .lbg__panel-media .lbg__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lbg__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: -22px 0 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--lbg-bg) 85%, transparent);
    color: var(--lbg-fg);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .lbg__arrow:hover {
    background: var(--lbg-bg);
  }

  .lbg__arrow--prev { left: 12px; }
  .lbg__arrow--next { right: 12px; }

  .lbg__panel-body {
    padding: 1.5em 16px 2em;
  }

  .lbg__look-subtitle {
    margin: 0 0 0.4em;
    font-size: 0.8em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .lbg__look-title {
    margin: 0 0 0.5em;
    color: inherit;
  }

  .lbg__look-text {
    margin-bottom: 1.25em;
  }

  /* Product list */
  .lbg__products {
    display: grid;
    gap: 1.25em;
    margin: 1.5em 0 0;
    padding: 0;
    list-style: none;
  }

  .lbg__product {
    margin: 0;
  }

  .lbg__product-link {
    display: grid;
    grid-template-columns: var(--lbg-thumb-w) minmax(0, 1fr);
    gap: 1em;
    align-items: start;
    color: inherit;
    text-decoration: none;
  }

  .lbg__product-image {
    position: relative;
    display: block;
    aspect-ratio: var(--lbg-thumb-ratio);
    overflow: hidden;
    border-radius: min(var(--lbg-radius), 8px);
    background: rgba(127, 127, 127, 0.08);
  }

  .lbg__product-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lbg__product-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35em;
  }

  .lbg__product-vendor {
    font-size: 0.8em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .lbg__product-title {
    line-height: 1.3;
  }

  .lbg__product-link:hover .lbg__product-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .lbg__product-price {
    font-size: 0.93em;
    opacity: 0.85;
  }

  .lbg__product-price s {
    margin-right: 0.4em;
    opacity: 0.6;
  }

  .lbg__product-soldout {
    font-size: 0.8em;
    opacity: 0.65;
  }

  .lbg__product-cta {
    margin-top: 0.4em;
    font-size: 0.8em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lbg--cta-underline .lbg__product-cta {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .lbg--cta-button .lbg__product-cta {
    padding: 0.6em 1.2em;
    border: 1px solid currentColor;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .lbg--cta-button .lbg__product-link:hover .lbg__product-cta {
    background: var(--lbg-fg);
    color: var(--lbg-bg);
  }

  /* Quick add */
  .lbg__product--quick-add {
    display: grid;
    grid-template-columns: var(--lbg-thumb-w) minmax(0, 1fr);
    gap: 1em;
    align-items: start;
  }

  .lbg__product--quick-add .lbg__product-title {
    color: inherit;
    text-decoration: none;
  }

  .lbg__product--quick-add .lbg__product-title:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .lbg__quick-add {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6em;
    width: 100%;
    margin-top: 0.4em;
  }

  .lbg__option {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .lbg__option--single {
    display: none;
  }

  .lbg__option-name {
    margin-bottom: 0.35em;
    padding: 0;
    font-size: 0.8em;
    opacity: 0.7;
  }

  .lbg__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
  }

  .lbg__chip {
    min-width: 2.6em;
    margin: 0;
    padding: 0.45em 0.7em;
    border: 1px solid color-mix(in srgb, var(--lbg-fg) 25%, transparent);
    border-radius: min(var(--lbg-radius), 4px);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.85em;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .lbg__chip:hover {
    border-color: var(--lbg-fg);
  }

  .lbg__chip[aria-pressed='true'] {
    border-color: var(--lbg-fg);
    background: var(--lbg-fg);
    color: var(--lbg-bg);
  }

  .lbg__chip.is-unavailable {
    opacity: 0.4;
    text-decoration: line-through;
  }

  .lbg__chip:focus-visible,
  .lbg__add:focus-visible {
    outline: 2px solid var(--lbg-fg);
    outline-offset: 2px;
  }

  .lbg__add {
    margin: 0.2em 0 0;
    padding: 0.75em 1.4em;
    border: 1px solid var(--lbg-fg);
    border-radius: min(var(--lbg-radius), 4px);
    background: var(--lbg-fg);
    color: var(--lbg-bg);
    font: inherit;
    font-size: 0.8em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .lbg__add:hover:not(:disabled) {
    opacity: 0.85;
  }

  .lbg__add:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .lbg__add.is-loading {
    cursor: progress;
    opacity: 0.7;
  }

  .lbg__add-status {
    margin: 0;
    font-size: 0.8em;
  }

  .lbg__add-status:empty {
    display: none;
  }

  .lbg__add-status.is-error {
    color: #c0392b;
  }

  .lbg__bag {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    margin: 2em -16px -2em;
    padding: 1em 16px;
    border-top: 1px solid color-mix(in srgb, var(--lbg-fg) 12%, transparent);
    background: var(--lbg-bg);
  }

  .lbg__bag-count,
  .lbg__bag-link {
    font-size: 0.9em;
  }

  .lbg__bag[hidden] {
    display: none;
  }

  .lbg__bag-link {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    white-space: nowrap;
  }

  .lbg__look-button {
    margin-top: 2em;
  }

  .lbg__empty {
    opacity: 0.6;
  }

  @media screen and (min-width: 750px) {
    lookbook-gallery {
      padding-top: var(--lbg-pt);
      padding-bottom: var(--lbg-pb);
    }

    .lbg__container {
      padding-inline: var(--lbg-pad);
    }

    .lbg__grid {
      grid-template-columns: repeat(var(--lbg-cols-t), minmax(0, 1fr));
    }

    /* Popup: centered, image beside products */
    .lbg__dialog {
      inset: 0;
      width: min(var(--lbg-popup-w), calc(100vw - 40px));
      height: min(var(--lbg-popup-h), calc(100dvh - 40px));
      max-height: none;
      margin: auto;
      border-radius: min(var(--lbg-radius), 16px);
    }

    .lbg__dialog[open] {
      animation: lbg-fade-in 0.2s ease-out;
    }

    .lbg__dialog-inner {
      height: 100%;
      max-height: none;
      overflow: hidden;
    }

    .lbg__close {
      position: absolute;
      top: 0;
      right: 0;
      width: 56px;
      height: 56px;
      padding: 0;
      justify-content: center;
      background: transparent;
    }

    .lbg--popup-image-right .lbg__close {
      right: auto;
      left: 0;
    }

    .lbg__panel:not([hidden]) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      height: 100%;
    }

    .lbg--popup-image-right .lbg__panel-media {
      order: 2;
    }

    .lbg__panel-media {
      aspect-ratio: auto;
      max-height: none;
      height: 100%;
    }

    .lbg__panel-body {
      height: 100%;
      overflow-y: auto;
      box-sizing: border-box;
      padding: 56px 2.5em 2.5em;
    }

    /* The panel body is the scroll container here; its bottom padding would
       otherwise hold the sticky bar 2.5em above the edge */
    .lbg__bag {
      bottom: -2.5em;
      margin: 2.5em -2.5em -2.5em;
      padding: 1.1em 2.5em;
    }
  }

  @media screen and (min-width: 990px) {
    .lbg__grid {
      grid-template-columns: repeat(var(--lbg-cols-d), minmax(0, 1fr));
    }
  }

  @keyframes lbg-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lbg__dialog[open] { animation: none; }
    .lbg__media img { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('lookbook-gallery')) {
    class LookbookGallery extends HTMLElement {
      connectedCallback() {
        this.dialog = this.querySelector('.lbg__dialog');
        this.panels = [...this.querySelectorAll('[data-lbg-panel]')];
        this.current = -1;
        this.opener = null;

        this.onClick = this.onClick.bind(this);
        this.onKeydown = this.onKeydown.bind(this);
        this.onClosed = this.onClosed.bind(this);
        this.openFromHash = this.openFromHash.bind(this);

        this.addEventListener('click', this.onClick);
        this.dialog.addEventListener('keydown', this.onKeydown);
        this.dialog.addEventListener('close', this.onClosed);
        window.addEventListener('hashchange', this.openFromHash);

        this.detectColors();
        this.openFromHash();
      }

      disconnectedCallback() {
        window.removeEventListener('hashchange', this.openFromHash);
        if (this.dialog?.open) this.dialog.close();
        document.documentElement.style.removeProperty('overflow');
      }

      // Popup inherits the page's background and text color unless set in the editor
      detectColors() {
        const isVisible = (c) => c && c !== 'transparent' && !/rgba\(.*,\s*0\)$/.test(c);
        let el = this;
        let bg = null;
        while (el && !bg) {
          const c = getComputedStyle(el).backgroundColor;
          if (isVisible(c)) bg = c;
          el = el.parentElement;
        }
        this.style.setProperty('--lbg-auto-bg', bg || '#fff');
        this.style.setProperty('--lbg-auto-fg', getComputedStyle(this).color);
      }

      onClick(e) {
        const opener = e.target.closest('[data-lbg-open]');
        if (opener) {
          this.opener = opener;
          return this.open(Number(opener.dataset.lbgOpen));
        }
        const chip = e.target.closest('[data-lbg-chip]');
        if (chip) return this.selectChip(chip);
        const add = e.target.closest('[data-lbg-add]');
        if (add) return this.addToCart(add);
        if (e.target.closest('[data-lbg-close]')) return this.close();
        if (e.target.closest('[data-lbg-prev]')) return this.step(-1);
        if (e.target.closest('[data-lbg-next]')) return this.step(1);
        // Clicking the backdrop (outside the popup box) closes it
        if (e.target === this.dialog) this.close();
      }

      onKeydown(e) {
        if (e.target.closest('[data-lbg-option]')) return;
        if (e.key === 'ArrowLeft') this.step(-1);
        if (e.key === 'ArrowRight') this.step(1);
      }

      open(index) {
        const panel = this.panels[index];
        if (!panel) return;

        this.panels.forEach((p, i) => (p.hidden = i !== index));
        this.current = index;

        if (!this.dialog.open) {
          this.dialog.showModal();
          document.documentElement.style.overflow = 'hidden';
          this.refreshBag();
        }
        this.panels[index].querySelectorAll('[data-lbg-product]').forEach((p) => this.syncProduct(p));

        panel.querySelector('.lbg__panel-body')?.scrollTo(0, 0);
        this.dialog.querySelector('.lbg__dialog-inner')?.scrollTo(0, 0);

        const anchor = panel.dataset.anchor;
        if (anchor && window.location.hash !== anchor) {
          history.replaceState(history.state, '', anchor);
        }
      }

      step(delta) {
        if (this.current < 0) return;
        const n = this.panels.length;
        this.open((this.current + delta + n) % n);
      }

      close() {
        if (this.dialog.open) this.dialog.close();
      }

      onClosed() {
        this.current = -1;
        document.documentElement.style.removeProperty('overflow');
        if (this.panels.some((p) => p.dataset.anchor === window.location.hash)) {
          history.replaceState(history.state, '', window.location.pathname + window.location.search);
        }
        this.opener?.focus();
      }

      openFromHash() {
        const hash = window.location.hash;
        if (!hash) return;
        const index = this.panels.findIndex((p) => p.dataset.anchor === hash);
        if (index > -1) this.open(index);
      }

      selectBlock(blockId) {
        const index = this.panels.findIndex((p) => p.dataset.blockId === blockId);
        if (index > -1) this.open(index);
      }

      /* ---------- Quick add ---------- */

      variantsFor(product) {
        if (!product._variants) {
          const json = product.querySelector('[data-lbg-variants]');
          product._variants = json ? JSON.parse(json.textContent) : [];
        }
        return product._variants;
      }

      // Current selection per option index; null where nothing is chosen yet
      selectionFor(product) {
        return [...product.querySelectorAll('[data-lbg-option]')].map((fieldset) => {
          const pressed = fieldset.querySelector('[data-lbg-chip][aria-pressed="true"]');
          return pressed ? pressed.dataset.value : null;
        });
      }

      selectChip(chip) {
        if (chip.classList.contains('is-unavailable')) return;
        const fieldset = chip.closest('[data-lbg-option]');
        fieldset.querySelectorAll('[data-lbg-chip]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        this.syncProduct(chip.closest('[data-lbg-product]'));
      }

      // Update chip availability, the add button and the thumbnail for the current selection
      syncProduct(product) {
        const button = product.querySelector('[data-lbg-add]');
        if (!button || button.classList.contains('is-loading')) return;
        const fieldsets = [...product.querySelectorAll('[data-lbg-option]')];
        if (!fieldsets.length) return; // single-variant product: variant id is on the button

        const variants = this.variantsFor(product);
        const selection = this.selectionFor(product);

        // A value is unavailable if no in-stock variant has it alongside the other chosen options
        fieldsets.forEach((fieldset, i) => {
          fieldset.querySelectorAll('[data-lbg-chip]').forEach((chip) => {
            const ok = variants.some(
              (v) =>
                v.available &&
                v.options[i] === chip.dataset.value &&
                selection.every((val, j) => j === i || val === null || v.options[j] === val)
            );
            chip.classList.toggle('is-unavailable', !ok);
          });
        });

        const missing = selection.findIndex((val) => val === null);
        const variant = missing === -1 ? variants.find((v) => v.options.every((o, i) => o === selection[i])) : null;

        if (missing > -1) {
          const name = fieldsets[missing].dataset.name.toLowerCase();
          button.textContent = `${this.dataset.labelSelect} ${name}`;
          button.disabled = true;
          delete button.dataset.variantId;
        } else if (!variant || !variant.available) {
          button.textContent = this.dataset.labelSoldOut;
          button.disabled = true;
          delete button.dataset.variantId;
        } else {
          button.textContent = this.dataset.labelAdd;
          button.disabled = false;
          button.dataset.variantId = variant.id;
        }

        const thumb = product.querySelector('.lbg__product-image img');
        if (thumb && variant?.image) {
          thumb.removeAttribute('srcset');
          thumb.src = variant.image;
        }
      }

      async addToCart(button) {
        const id = Number(button.dataset.variantId);
        if (!id || button.disabled) return;
        const product = button.closest('[data-lbg-product]');
        const status = product.querySelector('[data-lbg-status]');

        button.classList.add('is-loading');
        button.textContent = this.dataset.labelAdding;
        status.textContent = '';
        status.classList.remove('is-error');

        // Themes built on Shopify's standard cart events (e.g. Horizon) update their cart from this
        let settle;
        const promise = new Promise((resolve, reject) => (settle = { resolve, reject }));
        promise.catch(() => {});
        const event = new Event('shopify:cart:lines-update', { bubbles: true });
        Object.assign(event, {
          action: 'add',
          context: 'dialog',
          lines: [{ merchandiseId: `gid://shopify/ProductVariant/${id}`, quantity: 1 }],
          promise,
        });
        // Dispatched from inside the popup so drawer-style carts wait until the lookbook closes
        button.dispatchEvent(event);

        try {
          const res = await fetch(`${this.dataset.cartAddUrl}.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [{ id, quantity: 1 }], sections: 'cart-icon-bubble' }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.description || data.message || 'Could not add to bag');

          const cart = await this.fetchCart();
          settle.resolve({ cart: this.toStandardCart(cart), detail: { itemCount: cart.item_count } });
          this.notifyTheme(id, cart, data.sections);
          this.showBag(cart.item_count);

          button.classList.remove('is-loading');
          button.textContent = this.dataset.labelAdded;
          setTimeout(() => {
            this.syncProduct(product);
            this.resetSingle(button);
          }, 2000);
        } catch (err) {
          settle.reject(err);
          button.classList.remove('is-loading');
          status.textContent = err.message;
          status.classList.add('is-error');
          this.syncProduct(product);
          this.resetSingle(button);
        }
      }

      resetSingle(button) {
        const product = button.closest('[data-lbg-product]');
        if (!product.querySelector('[data-lbg-option]')) button.textContent = this.dataset.labelAdd;
      }

      async fetchCart() {
        const res = await fetch(`${this.dataset.cartUrl}.js`, { headers: { Accept: 'application/json' } });
        return res.json();
      }

      toStandardCart(cart) {
        const money = (cents) => ({ amount: (cents / 100).toFixed(2), currencyCode: cart.currency });
        return {
          id: cart.token,
          totalQuantity: cart.item_count,
          cost: { totalAmount: money(cart.total_price) },
          lines: cart.items.map((item) => ({
            id: item.key,
            quantity: item.quantity,
            cost: { totalAmount: money(item.final_line_price) },
          })),
          discountCodes: [],
        };
      }

      // Let other theme families know the cart changed
      notifyTheme(variantId, cart, sections) {
        // Dawn and Dawn-based themes: swap in the re-rendered cart icon and publish to their pub/sub
        const bubble = document.getElementById('cart-icon-bubble');
        const html = sections?.['cart-icon-bubble'];
        if (bubble && html) {
          const fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('.shopify-section');
          if (fresh) bubble.innerHTML = fresh.innerHTML;
        }
        if (typeof window.publish === 'function') {
          window.publish('cart-update', { source: 'lookbook-gallery', productVariantId: variantId, cartData: cart });
        }
        // Everyone else: listen for this and refresh your cart UI
        document.dispatchEvent(new CustomEvent('lookbook:cart:added', { bubbles: true, detail: { variantId, cart } }));
      }

      async refreshBag() {
        if (!this.querySelector('[data-lbg-bag]')) return;
        try {
          const cart = await this.fetchCart();
          this.showBag(cart.item_count);
        } catch (e) {}
      }

      showBag(count) {
        this.querySelectorAll('[data-lbg-bag]').forEach((bag) => {
          bag.hidden = count < 1;
          const label = bag.querySelector('[data-lbg-bag-count]');
          label.textContent = label.dataset.template.replace('[count]', count);
        });
      }
    }

    customElements.define('lookbook-gallery', LookbookGallery);

    // Theme editor: open the look being edited
    document.addEventListener('shopify:block:select', (e) => {
      e.target.closest('lookbook-gallery')?.selectBlock(e.detail.blockId);
    });
    document.addEventListener('shopify:block:deselect', (e) => {
      e.target.closest('lookbook-gallery')?.close();
    });
  }
{% endjavascript %}

